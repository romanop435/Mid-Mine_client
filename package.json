{
  "name": "mid-mine-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop Minecraft launcher based on the Mid-Mine Figma design.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.0",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.511.0",
    "minecraft-server-util": "^5.4.4",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "zod": "^3.24.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.midmine.launcher",
    "productName": "Mid-Mine Launcher",
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "asar": true,
    "win": {
      "target": "nsis"
    }
  }
}
